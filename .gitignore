env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# --- Runtime output ---
*.log
exports/
uploads/
*.bak
